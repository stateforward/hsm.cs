<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>2.0.1</Version>
    <PackageVersion>2.0.1</PackageVersion>
    <Description>Hierarchical State Machine runtime and DSL for C#.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/stateforward/hsm.cs</RepositoryUrl>
    <RootNamespace>Stateforward.Hsm</RootNamespace>
    <AssemblyName>Stateforward.Hsm</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Stateforward.Hsm.Tests/**/*.cs" />
    <Compile Remove="Stateforward.Hsm.Benchmarks/**/*.cs" />
    <Compile Remove="Stateforward.Hsm.Conformance/**/*.cs" />
    <Compile Remove="TrafficLightBench/**/*.cs" />
    <None Include="Stateforward.Hsm.Tests/**/*.cs" />
    <None Include="Stateforward.Hsm.Benchmarks/**/*.cs" />
    <None Include="Stateforward.Hsm.Conformance/**/*.cs" />
    <None Include="TrafficLightBench/**/*.cs" />
  </ItemGroup>
</Project>
